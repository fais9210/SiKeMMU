# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this app is hosted (e.g. http://localhost:3000 for local dev)
APP_URL="http://localhost:3000"

# PostgreSQL Database Configuration
# Required for src/db/db.ts to connect to your PostgreSQL database.
# If running PostgreSQL locally (e.g. via Postgres App or Docker):
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"
SQL_DB_NAME="madrasah_db"

# Server Port (Default is 3000)
PORT=3000
