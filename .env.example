# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this app is hosted (e.g. http://localhost:3000 for local dev)
APP_URL="http://localhost:3000"

# PostgreSQL / Neon DB Database Configuration
# You can use a single connection string (recommended for Neon DB / Supabase / Cloud Postgres):
# DATABASE_URL="postgresql://user:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# NEON_DATABASE_URL=""

# Or specify individual parameters:
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"
SQL_DB_NAME="madrasah_db"
SQL_SSL="false"

# Server Port (Default is 3000)
PORT=3000
