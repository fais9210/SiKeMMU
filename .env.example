# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this app is hosted (e.g. http://localhost:3000 for local dev)
APP_URL="http://localhost:3000"

# Supabase / PostgreSQL Database Configuration
# Use the connection string from Supabase Project Settings > Database.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Optional fallback for local development
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"
SQL_DB_NAME="madrasah_db"

# Server Port (Default is 3000)
PORT=3000
